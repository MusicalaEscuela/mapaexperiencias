rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn() && request.auth.token.email in [
        'alekcaballeromusic@gmail.com',
        'catalina.medina.leal@gmail.com'
      ];
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return userDoc().data;
    }

    function isActive() {
      return adminEmail() || (hasProfile() && profile().active == true);
    }

    function isAdmin() {
      return adminEmail() || (hasProfile() && profile().role == 'admin' && profile().active == true);
    }

    function isEditor() {
      return isAdmin() || (
        hasProfile() &&
        profile().active == true &&
        profile().role in ['docente_editor', 'coordinador']
      );
    }

    function canAccessArt(artId) {
      return isAdmin() || (
        isActive() &&
        (profile().allowedArts.hasAny(['*']) || profile().allowedArts.hasAny([artId]))
      );
    }

    function canAccessRoute(routeId) {
      return isAdmin() || (
        isActive() &&
        (profile().allowedRoutes.hasAny(['*']) || profile().allowedRoutes.hasAny([routeId]))
      );
    }

    function canEditExperienceData(data) {
      return isEditor() && canAccessArt(data.artId) && canAccessRoute(data.routeId);
    }

    function canEditSkillData(data) {
      return isEditor() && canAccessArt(data.artId);
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && (
        adminEmail() ||
        (
          request.resource.data.email == request.auth.token.email &&
          exists(/databases/$(database)/documents/teacherInvites/$(request.auth.token.email)) &&
          get(/databases/$(database)/documents/teacherInvites/$(request.auth.token.email)).data.active == true
        )
      );
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
      );
      allow delete: if false;
    }

    match /teacherInvites/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /arts/{artId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if isActive();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /experiences/{experienceId} {
      allow read: if isActive() && (
        isAdmin() ||
        resource.data.status == 'published' ||
        (canAccessArt(resource.data.artId) && canAccessRoute(resource.data.routeId))
      );
      allow create: if canEditExperienceData(request.resource.data);
      allow update: if canEditExperienceData(resource.data) && canEditExperienceData(request.resource.data);
      allow delete: if canEditExperienceData(resource.data);
    }

    match /skills/{skillId} {
      allow read: if isActive();
      allow create: if canEditSkillData(request.resource.data);
      allow update: if canEditSkillData(resource.data) && canEditSkillData(request.resource.data);
      allow delete: if isEditor() && canAccessArt(resource.data.artId);
    }

    match /changeLogs/{logId} {
      allow read: if isActive();
      allow create: if isActive();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
